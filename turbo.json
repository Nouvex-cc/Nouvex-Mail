{
	"$schema": "https://turborepo.com/schema.json",
	"globalPassThroughEnv": [
		"DATABASE_URL",
		"NATS_URL",
		"SECRETS_KEY",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"S3_ENDPOINT",
		"S3_BUCKET",
		"S3_ACCESS_KEY_ID",
		"S3_SECRET_ACCESS_KEY"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**", "bin/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"lint": {},
		"typecheck": {
			"dependsOn": ["^build"]
		}
	},
	"agentGuidance": false
}
