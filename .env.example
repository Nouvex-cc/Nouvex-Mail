DATABASE_URL=postgres://nouvex:nouvex@localhost:5432/nouvex
NATS_URL=nats://localhost:4222
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# host port for postgres if 5432 is taken
PG_PORT=5432
E2E_TELEMETRY_DISABLED=1
# 32 random bytes, base64: head -c32 /dev/urandom | base64
SECRETS_KEY=
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=nouvex
S3_ACCESS_KEY_ID=nouvex
S3_SECRET_ACCESS_KEY=nouvex
# Accept the self-signed certificates of the local mail server. Never in production.
MAIL_INSECURE_TLS=1
# Sorting with embeddings: docker compose --profile embed up -d. Empty sorts by rules alone.
EMBED_URL=
# Hosted mail (docs/deploy.md, Hosted mail). Our MX's name, and the SPF record customers include.
MX_HOST=mx.nouvex.cc
SPF_INCLUDE=spf.nouvex.cc
# Sending outside Nouvex through Amazon SES. Empty: hosted mailboxes only send to Nouvex mailboxes.
SES_REGION=
SES_CONFIGURATION_SET=
# The SNS topic SES reports bounces and complaints to; only it reaches /webhooks/ses.
SES_TOPIC_ARN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
