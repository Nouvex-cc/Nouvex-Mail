# Copy to deploy/.env and fill in. Generate each secret with: openssl rand -base64 32
DOMAIN=mail.nouvex.cc
# Behind a reverse proxy that already does HTTPS, Caddy only answers plain HTTP: SITE=:80
SITE=
PG_PASSWORD=
BETTER_AUTH_SECRET=
# Encrypts the mail account passwords. Losing it means every account has to be added again.
SECRETS_KEY=
S3_ACCESS_KEY_ID=nouvex
S3_SECRET_ACCESS_KEY=
SENTRY_DSN=
# Pushes new mail to the iPhone app: an APNs key from developer.apple.com (Keys, Apple Push Notifications service),
# the .p8 file as base64 (base64 -i AuthKey_XXXX.p8), its key id and the team id. Left empty, there are no pushes.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
