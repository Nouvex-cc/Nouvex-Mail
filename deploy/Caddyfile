{$SITE} {
	encode zstd gzip
	# A private mail server: no search engine lists it, robots.txt says the same.
	header X-Robots-Tag "noindex, nofollow"

	# The same paths the web app's dev server forwards; the Apple apps use them too.
	@api path /api/* /accounts /accounts/* /prefs /image /ws /health
	handle @api {
		reverse_proxy api:3000
	}

	# Ties the Apple apps to this domain for passkeys; Apple only reads it as JSON.
	header /.well-known/apple-app-site-association Content-Type application/json

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
