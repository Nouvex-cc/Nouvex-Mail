{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "MessageSend",
	"description": "Command: API asks the engine to send a message from one account.",
	"type": "object",
	"properties": {
		"accountId": { "type": "string" },
		"to": { "type": "array", "items": { "type": "string" } },
		"cc": { "type": "array", "items": { "type": "string" } },
		"bcc": { "type": "array", "items": { "type": "string" } },
		"subject": { "type": "string" },
		"text": { "type": "string" },
		"inReplyTo": { "type": "string", "description": "Id of the message this answers, for the thread headers." },
		"attachments": {
			"type": "array",
			"description": "Files uploaded through the API, stored in S3 as upload/<accountId>/<id>.",
			"items": {
				"type": "object",
				"properties": { "id": { "type": "string" }, "name": { "type": "string" }, "type": { "type": "string" } },
				"required": ["id", "name", "type"],
				"additionalProperties": false
			}
		}
	},
	"required": ["accountId", "to", "cc", "bcc", "subject", "text"],
	"additionalProperties": false
}
